# App Configuration
VITE_APP_NAME=VanCT Developer Toolkit

# Primary API Base URL (Vite exposes variables prefixed with VITE_ to client-side code)
# Development (Express backend default port 5000):
VITE_API_BASE_URL=http://localhost:5000
# Production example:
# VITE_API_BASE_URL=https://api.example.com
# Same-origin / Reverse-proxy deployment (routes /api via Nginx or Vite proxy):
# VITE_API_BASE_URL=

# HTTP Request Timeout in milliseconds
VITE_API_TIMEOUT=15000

# Backend Services (Dual-backend template configurations)
VITE_EXPRESS_API_URL=http://localhost:5000
VITE_SPRING_API_URL=http://localhost:8080
